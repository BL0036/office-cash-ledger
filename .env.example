# Office Daily Cash Ledger — Cloud Sync (Phase 10b) Firebase config.
#
# Copy this file to .env (same folder) and fill in the values from your
# Firebase project's console. See README.md's "Cloud Sync setup" section
# for exactly where to find each one.
#
# Leave ALL of these blank (or don't create .env at all) to run the app
# with Cloud Sync completely disabled — every other screen works fully
# offline with zero setup, same as before Phase 10b.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only used by the test suite (scripts/test-sync.ts) to point the Firebase
# client SDK at the local Firestore/Auth emulators instead of a live
# project. Leave blank for normal app use — never set these in a real
# deployment. (The test script sets these itself; you never need to.)
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
